---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import { getPosts, formatDate, readingTime } from '../../lib';
import { getCopy, localPath, postPath, tagPath, type Lang } from '../../i18n';
import '../../styles/notebook-home.css';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getCopy(lang);
const labels = lang === 'en' ? {
  title: 'Research notebook', description: 'Notes on science, technology, and everyday questions.',
  index: 'Notebook index', entries: 'Entries', topics: 'Topics', updated: 'Latest entry',
  topicIndex: 'Topic index', about: 'About the notebook', open: 'Read entry',
} : {
  title: '研究笔记', description: '在同一本笔记里，记录科学、技术与日常中的问题。',
  index: '笔记索引', entries: '文章', topics: '主题', updated: '最近更新',
  topicIndex: '主题索引', about: '关于这本笔记', open: '阅读笔记',
};
const posts = (await getPosts(lang)).sort((a, b) =>
  Number(b.data.featured) - Number(a.data.featured) ||
  b.data.date.valueOf() - a.data.date.valueOf() ||
  (a.data.translationKey || a.data.slug).localeCompare(b.data.translationKey || b.data.slug, 'en')
);
const topics = [...new Set(posts.flatMap(post => post.data.tags))].map(tag => ({
  tag, count: posts.filter(post => post.data.tags.includes(tag)).length,
})).sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag, 'en'));
const latest = posts.reduce<Date | undefined>((newest, post) => !newest || post.data.date > newest ? post.data.date : newest, undefined);
const ordinal = (number: number) => String(number).padStart(2, '0');
---
<Base lang={lang}>
  <div class="notebook-home">
    <section class="notebook-hero" aria-labelledby="notebook-title">
      <div class="notebook-intro">
        <div class="notebook-kicker"><span aria-hidden="true"></span> DOBBY'S HOME <b aria-hidden="true">/</b> OPEN NOTEBOOK</div>
        <h1 id="notebook-title">{labels.title}<span aria-hidden="true">.</span></h1>
        <p>{labels.description}</p>
        <a href={localPath(lang, '/about/')} class="notebook-link">{labels.about}<Icon name="arrow" size={16} /></a>
      </div>
      <div class="notebook-summary">
        <div class="notebook-summary-label"><span>{labels.index}</span><Icon name="book" size={17} /></div>
        <dl>
          <div><dt>{labels.entries}</dt><dd>{ordinal(posts.length)}</dd></div>
          <div><dt>{labels.topics}</dt><dd>{ordinal(topics.length)}</dd></div>
          {latest && <div><dt>{labels.updated}</dt><dd><time datetime={latest.toISOString()}>{formatDate(latest, lang)}</time></dd></div>}
        </dl>
      </div>
    </section>

    <div class="notebook-layout">
      <aside class="notebook-sidebar" aria-labelledby="notebook-topics">
        <div class="notebook-sidebar-heading"><span class="notebook-label">INDEX / 01</span><h2 id="notebook-topics">{labels.topicIndex}</h2></div>
        <nav class="notebook-topics" aria-label={labels.topicIndex}>
          {topics.map(({ tag, count }) => <a href={tagPath(lang, tag)}><span>{tag}</span><span class="notebook-topic-count">{ordinal(count)}</span></a>)}
        </nav>
        <div class="notebook-side-links">
          <a href={localPath(lang, '/archive/')}><span>{t.archive}</span><Icon name="arrow" size={15} /></a>
          <a href={localPath(lang, '/rss.xml')}><span>{t.subscribe}</span><Icon name="rss" size={15} /></a>
        </div>
      </aside>

      <section class="notebook-journal" aria-labelledby="articles-title">
        <header class="notebook-journal-heading">
          <div><span class="notebook-label">LOG / 02</span><h2 id="articles-title">{t.latest}</h2></div>
          <a href={localPath(lang, '/archive/')} class="notebook-link">{t.allArchive}<Icon name="arrow" size={16} /></a>
        </header>
        <div class="notebook-list">
          {posts.map((post, index) => <article class="post-card notebook-entry">
            <div class="notebook-entry-number" aria-hidden="true">{ordinal(index + 1)}</div>
            <div class="notebook-entry-body">
              <div class="notebook-entry-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time><span aria-hidden="true">/</span><span>{readingTime(post.body)} {t.minutes}</span>{post.data.featured && <span class="notebook-featured">{t.featured}</span>}</div>
              <h3><a href={postPath(post)}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="post-tags">{post.data.tags.map(tag => <a href={tagPath(lang, tag)}>{tag}</a>)}</div>
            </div>
            <a class="notebook-entry-open" href={postPath(post)} aria-label={`${labels.open}: ${post.data.title}`}><Icon name="arrow" size={20} /></a>
          </article>)}
          {!posts.length && <div class="empty-state"><Icon name="book" size={28} /><h3>{t.emptyTitle}</h3><p>{t.emptyDescription}</p></div>}
        </div>
      </section>
    </div>
  </div>
</Base>
