---
import Base from '../../layouts/Base.astro';
import PostCard from '../PostCard.astro';
import Icon from '../Icon.astro';
import { getPosts } from '../../lib';
import { getCopy, localPath, tagPath, type Lang } from '../../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getCopy(lang);
const posts = (await getPosts(lang)).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || b.data.date.valueOf() - a.data.date.valueOf());
const tags = [...new Set(posts.flatMap(post => post.data.tags))];
---
<Base lang={lang}>
  <section class="home-hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span>{t.heroLabel}</div>
      <h1>{t.heroFirst}<br />{t.heroSecond}<span class="hero-emphasis">{lang === 'en' && ' '}{t.heroAccent}</span></h1>
      <p>{t.heroDescription[0]}<br class="desktop-break" />{t.heroDescription[1]}</p>
      <a class="text-link" href={localPath(lang, '/about/')}>{t.aboutCorner}<Icon name="arrow" size={17} /></a>
    </div>
    <div class="hero-note" aria-hidden="true"><div class="note-index">FIELD NOTES <span>NO. 001</span></div><svg class="orbit-art" viewBox="0 0 300 200" fill="none"><ellipse cx="151" cy="98" rx="102" ry="40" transform="rotate(-28 151 98)"/><ellipse cx="151" cy="98" rx="102" ry="40" transform="rotate(32 151 98)"/><ellipse cx="151" cy="98" rx="40" ry="94" transform="rotate(4 151 98)"/><circle cx="151" cy="98" r="23" class="orbit-core"/><circle cx="67" cy="115" r="5" class="orbit-dot"/><circle cx="209" cy="151" r="4" class="orbit-dot"/><circle cx="158" cy="12" r="4" class="orbit-dot"/><path d="M147 98h8m-4-4v8" class="orbit-cross"/></svg><p>{t.slow}</p><small>STAY CURIOUS. KEEP EXPLORING.</small><span class="note-corner"></span></div>
  </section>
  <div class="home-content">
    <section aria-labelledby="articles-title">
      <div class="section-top"><h2 id="articles-title">{t.latest}<span>{String(posts.length).padStart(2, '0')}</span></h2><a href={localPath(lang, '/archive/')}>{t.allArchive}<Icon name="arrow" size={16} /></a></div>
      <div class="post-list">{posts.map((post, index) => <PostCard post={post} index={index} />)}{!posts.length && <div class="empty-state"><Icon name="book" size={32} /><h3>{t.emptyTitle}</h3><p>{t.emptyDescription}</p></div>}</div>
    </section>
    <aside class="home-aside">
      <div class="aside-section"><span class="aside-label">HELLO, I'M DOBBY</span><div class="avatar-mark">d<span>·</span></div><h2>{t.hello}</h2><p>{t.introduction.map((line, index) => <>{index > 0 && <br />}{line}</>)}</p><a class="text-link" href={localPath(lang, '/about/')}>{t.meet}<Icon name="arrow" size={15} /></a></div>
      <div class="aside-section"><div class="aside-heading"><h3>{t.topics}</h3><span>TOPICS</span></div><div class="topic-list">{tags.map(tag => <a href={tagPath(lang, tag)}><span>{tag}</span><span>{posts.filter(post => post.data.tags.includes(tag)).length.toString().padStart(2, '0')}<Icon name="arrow" size={14} /></span></a>)}</div></div>
      <a class="subscribe-note" href={localPath(lang, '/rss.xml')}><Icon name="rss" size={20} /><div><strong>{t.subscribeTitle}</strong><p>{t.subscribeDescription}</p></div><Icon name="arrow" size={16} /></a>
    </aside>
  </div>
</Base>
