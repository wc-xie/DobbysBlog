---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib';
export async function getStaticPaths() {
  const posts = await getPosts();
  return [...new Set(posts.flatMap(post => post.data.tags))].map(tag => ({ params: { tag }, props: { tag, posts: posts.filter(post => post.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<Base title={tag}><header class="page-heading"><a class="back-link" href="/tags/">← 所有主题</a><h1>{tag}<span>。</span></h1><p>沿着这个方向，共有 {posts.length} 篇记录。</p></header><div class="narrow-list">{posts.map(post => <PostCard post={post} />)}</div></Base>
